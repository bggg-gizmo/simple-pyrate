<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.bggg.simplepyrate"
    android:versionCode="20603" android:versionName="2.6.3">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:label="Simple Pyrate" android:icon="@mipmap/pyrate_launcher" android:roundIcon="@mipmap/pyrate_launcher" android:theme="@style/PyrateTheme"
        android:extractNativeLibs="true" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:screenOrientation="user" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".QueueService" android:exported="false" android:foregroundServiceType="dataSync"/>
    </application>
</manifest>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Pyrate v2.5 • BGGG" Width="1170" Height="910" MinWidth="760" MinHeight="600"
        Background="#091319" Foreground="#E8E1CD" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Paper" Color="#F1E6CB"/>
    <SolidColorBrush x:Key="Muted" Color="#9EAEAD"/>
    <SolidColorBrush x:Key="Gold" Color="#E9BD72"/>
    <SolidColorBrush x:Key="Teal" Color="#7BC5B2"/>
    <SolidColorBrush x:Key="BorderInk" Color="#32454B"/>
    <SolidColorBrush x:Key="Panel" Color="#101D23"/>
    <SolidColorBrush x:Key="Field" Color="#0A151B"/>
    <DrawingImage x:Key="Seal">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#142B2D" Geometry="M 25,1 L 49,14 49,39 25,53 1,39 1,14 Z"><GeometryDrawing.Pen><Pen Brush="#BB965A" Thickness="1.3"/></GeometryDrawing.Pen></GeometryDrawing>
          <GeometryDrawing Geometry="M 25,8 L 25,40 M 12,25 L 38,25 M 16,21 L 16,26 A 9,9 0 0 0 34,26 L 34,21 M 25,39 L 20,34 M 25,39 L 30,34 M 25,8 A 3.6,3.6 0 1 0 25,15 A 3.6,3.6 0 1 0 25,8"><GeometryDrawing.Pen><Pen Brush="#E9BD72" Thickness="1.75" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
          <GeometryDrawing Brush="#7BC5B2" Geometry="M 9,34 L 11,31 13,34 11,37 Z M 37,34 L 39,31 41,34 39,37 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Small">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Kicker">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Heading">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Border" x:Key="Card">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="#2B3E45"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="19"/>
    </Style>
    <Style TargetType="Button" x:Key="BaseButton">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="Background" Value="#16252C"/>
      <Setter Property="BorderBrush" Value="#466068"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Rim" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Border x:Name="Wash" Background="#00FFFFFF" CornerRadius="5"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Background" Value="#16FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="Background" Value="#35000000"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rim" Property="BorderBrush" Value="#8BDBC7"/><Setter TargetName="Rim" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Rim" Property="Opacity" Value=".48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="#211A10"/>
      <Setter Property="BorderBrush" Value="#F5D496"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background">
        <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F1CD89" Offset="0"/><GradientStop Color="#D3A45E" Offset="1"/></LinearGradientBrush></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="1,0">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderBrush="#647F83" BorderThickness="1" Background="#091319" VerticalAlignment="Center">
                  <Path x:Name="Tick" Visibility="Hidden" Data="M 1,4 L 4,7 10,1" Stroke="#152321" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center" Margin="7,0,2,0" RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#85C9B8"/><Setter TargetName="Box" Property="BorderBrush" Value="#A7DDCD"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#7BC5B2"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#A7DDCD"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Focus" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox" x:Key="Cargo">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="59"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="CargoRim" Background="#0C171D" BorderBrush="#344951" BorderThickness="1" CornerRadius="7" Padding="10,7">
              <DockPanel LastChildFill="True">
                <Ellipse x:Name="Lamp" Width="7" Height="7" Fill="#52666C" VerticalAlignment="Top" Margin="5,4,0,0" DockPanel.Dock="Right"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CargoRim" Property="Background" Value="#30291C"/>
                <Setter TargetName="CargoRim" Property="BorderBrush" Value="#AE8750"/>
                <Setter TargetName="Lamp" Property="Fill" Value="#F4CC85"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CargoRim" Property="BorderBrush" Value="#E1BB78"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CargoRim" Property="BorderBrush" Value="#9DE0CC"/><Setter TargetName="CargoRim" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CargoRim" Property="Opacity" Value=".5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ScopeRim" Background="#0B161C" BorderBrush="#344951" BorderThickness="1" CornerRadius="6" Padding="9,5">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="Marker" Width="7" Height="7" Fill="#52666C" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ScopeRim" Property="Background" Value="#183233"/><Setter TargetName="ScopeRim" Property="BorderBrush" Value="#568D82"/><Setter TargetName="Marker" Property="Fill" Value="#8DDBBF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ScopeRim" Property="BorderBrush" Value="#9DE0CC"/><Setter TargetName="ScopeRim" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScopeRim" Property="BorderBrush" Value="#9DE0CC"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="CaretBrush" Value="#E9BD72"/>
      <Setter Property="SelectionBrush" Value="#408779"/>
      <Setter Property="BorderBrush" Value="#3D555C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Edge" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#80CEB8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value=".5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Choice" Padding="{TemplateBinding Padding}" Background="#102026">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#2F514E"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#25524D"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0A151B" BorderBrush="#3D555C" BorderThickness="1" CornerRadius="6"><Path Data="M 0,0 L 4,4 8,0" Stroke="#E9BD72" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,9,0"/></Border></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="9,3,24,3" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
              <Border x:Name="ComboFocus" IsHitTestVisible="False" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Background="#102026" BorderBrush="#527777" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="250">
                  <ScrollViewer><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="#8ED5C3"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="#628987"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#0B161C"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="BorderBrush" Value="#32454B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Margin="0,0,0,3" Padding="8,6" CornerRadius="4" Background="#101F26" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1C3439"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#203B3F"/><Setter TargetName="Row" Property="BorderBrush" Value="#628C84"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#9DE0CC"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition x:Name="VoyageRow" Height="300"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#101B21" BorderBrush="#2C4247" BorderThickness="0,0,0,1">
      <DockPanel Margin="24,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="SeaSound" Content="Sea sound" Margin="0,0,13,0" ToolTip="Play the local sea ambience loop"/>
          <CheckBox x:Name="Motion" Content="Motion" IsChecked="True" Margin="0,0,17,0" ToolTip="Animate the voyage, cannon effects and progress bar"/>
          <Button x:Name="ShowTools" Content="Shipyard" ToolTip="Check or refresh the machine-wide tools"/>
        </StackPanel>
        <Image Source="{StaticResource Seal}" Width="34" Height="36" VerticalAlignment="Center" Margin="0,0,11,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="S I M P L E  P Y R A T E" Foreground="#F1D096" FontFamily="Georgia" FontWeight="Bold" FontSize="15"/>
          <TextBlock Text="V2.5     /     BGGG  ·  EST. 2020" Style="{StaticResource Small}" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Margin="24,15,24,9" CornerRadius="10" BorderBrush="#536660" BorderThickness="1" Background="#172a32">
      <Grid x:Name="VoyageStage" ClipToBounds="True" AutomationProperties.Name="The midnight chart room">
        <TextBlock x:Name="VoyageAnnounce" AutomationProperties.LiveSetting="Polite" Width="1" Height="1" Opacity="0"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ClipToBounds="True" IsHitTestVisible="False">
      <Image x:Name="DeckAtmosphere" Opacity=".19" Stretch="UniformToFill" RenderTransformOrigin=".60,.60" Margin="-25,-50">
        <Image.RenderTransform><TranslateTransform x:Name="DeckDrift" X="0"/></Image.RenderTransform>
      </Image>
      <Border>
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#80091319" Offset="0"/><GradientStop Color="#E1091319" Offset="1"/></LinearGradientBrush></Border.Background>
      </Border>
    </Grid>
    <ScrollViewer x:Name="DeckScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,4,24,20">
        <Grid x:Name="Board">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="BoardLeft" Width="1.24*"/><ColumnDefinition x:Name="BoardGap" Width="14"/><ColumnDefinition x:Name="BoardRight" Width="1*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="MobileRow" Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="NewCargoCard" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="01   /   PLOT A COURSE" Style="{StaticResource Kicker}"/>
              <TextBlock Text="New haul" Style="{StaticResource Heading}" Margin="0,2,0,8"/>
              <DockPanel Margin="0,1,0,4">
                <Button x:Name="Paste" DockPanel.Dock="Right" Content="_Paste" MinHeight="26" Padding="9,3"/>
                <TextBlock Text="Source links" FontWeight="SemiBold"/>
              </DockPanel>
              <Grid>
                <TextBox x:Name="Links" AutomationProperties.Name="Source links" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch"/>
                <TextBlock x:Name="LinkHint" Text="Paste a video, playlist or channel link on each line" IsHitTestVisible="False" VerticalAlignment="Top" Margin="10,9" Style="{StaticResource Small}" TextWrapping="Wrap"/>
              </Grid>
              <TextBlock Text="Download scope" FontWeight="SemiBold" Margin="0,10,0,4"/>
              <UniformGrid Columns="2">
                <RadioButton x:Name="Single" Content="Single item per link" GroupName="DownloadScope" IsChecked="True" Margin="0,0,4,0"/>
                <RadioButton x:Name="Collection" Content="Playlist / full channel" GroupName="DownloadScope" Margin="4,0,0,0"/>
              </UniformGrid>
              <TextBlock Text="Cargo to collect" FontWeight="SemiBold" Margin="0,10,0,4"/>
              <UniformGrid Columns="3">
                <CheckBox x:Name="VideoMode" AutomationProperties.Name="MP4 video" Style="{StaticResource Cargo}" IsChecked="True" Margin="0,0,4,0">
                  <StackPanel><TextBlock Text="MP4" Foreground="#F1CE90" FontWeight="Bold"/><TextBlock Text="Video" Style="{StaticResource Small}"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="AudioMode" AutomationProperties.Name="MP3 audio" Style="{StaticResource Cargo}" Margin="4,0">
                  <StackPanel><TextBlock Text="MP3" Foreground="#F1CE90" FontWeight="Bold"/><TextBlock Text="Audio" Style="{StaticResource Small}"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="CaptionMode" AutomationProperties.Name="Transcript export" Style="{StaticResource Cargo}" Margin="4,0,0,0">
                  <StackPanel><TextBlock Text="Transcript" Foreground="#F1CE90" FontWeight="Bold"/><TextBlock Text="TXT / SRT" Style="{StaticResource Small}"/></StackPanel>
                </CheckBox>
              </UniformGrid>
              <UniformGrid x:Name="MediaOptions" Columns="2" Margin="0,8,0,0">
                <StackPanel x:Name="VideoOptions" Margin="0,0,4,0">
                  <TextBlock Text="Video quality" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                  <ComboBox x:Name="HeightChoice" AutomationProperties.Name="Video quality" SelectedIndex="0">
                    <ComboBoxItem Content="Best available" Tag="0"/><ComboBoxItem Content="Up to 2160p" Tag="2160"/><ComboBoxItem Content="Up to 1440p" Tag="1440"/><ComboBoxItem Content="Up to 1080p" Tag="1080"/><ComboBoxItem Content="Up to 720p" Tag="720"/><ComboBoxItem Content="Up to 480p" Tag="480"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="AudioOptions" Margin="4,0,0,0" Visibility="Collapsed">
                  <TextBlock Text="MP3 encoding" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                  <ComboBox x:Name="QualityChoice" AutomationProperties.Name="MP3 encoding" SelectedIndex="1">
                    <ComboBoxItem Content="320 kbps" Tag="320K"/><ComboBoxItem Content="192 kbps" Tag="192K"/><ComboBoxItem Content="128 kbps" Tag="128K"/><ComboBoxItem Content="Best variable bitrate" Tag="0"/>
                  </ComboBox>
                </StackPanel>
              </UniformGrid>
              <StackPanel x:Name="CaptionOptions" Visibility="Collapsed" Margin="0,9,0,0">
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="Caption languages" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                    <TextBox x:Name="Languages" Text="en" AutomationProperties.Name="Caption languages" ToolTip="Comma-separated language codes such as en, de, or all"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Transcript format" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CaptionChoice" AutomationProperties.Name="Transcript format" SelectedIndex="0">
                      <ComboBoxItem Content="Plain text (.txt)" Tag="TXT"/><ComboBoxItem Content="Timed captions (.srt)" Tag="SRT"/><ComboBoxItem Content="Both TXT and SRT" Tag="Both"/>
                    </ComboBox>
                  </StackPanel>
                </UniformGrid>
                <CheckBox x:Name="AutoCaptions" Content="Include auto-generated captions when available" IsChecked="True" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBlock Text="Save to" FontWeight="SemiBold" Margin="0,10,0,4"/>
              <DockPanel>
                <Button x:Name="Browse" DockPanel.Dock="Right" Content="_Browse" MinHeight="32" Margin="6,0,0,0"/>
                <TextBox x:Name="Destination" AutomationProperties.Name="Save folder"/>
              </DockPanel>
              <TextBlock x:Name="FormError" Foreground="#FFB8A7" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
              <Button x:Name="Queue" Content="✦   _Queue haul" Style="{StaticResource Primary}" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="FlightCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="02   /   TRACK THE VOYAGE" Style="{StaticResource Kicker}"/>
              <DockPanel Margin="0,2,0,8">
                <Border DockPanel.Dock="Right" Background="#163231" BorderBrush="#315A53" BorderThickness="1" CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
                  <TextBlock x:Name="ActiveStatus" Text="AT ANCHOR" Style="{StaticResource Kicker}" Foreground="#A0DEC9"/>
                </Border>
                <TextBlock Text="The deck" Style="{StaticResource Heading}"/>
              </DockPanel>
              <Border Background="#0A161B" BorderBrush="#30454A" BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,11">
                <StackPanel>
                  <TextBlock x:Name="ActiveTitle" Text="Nothing underway" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  <TextBlock x:Name="ActiveDetail" Text="Add links to begin a haul." Style="{StaticResource Small}" Margin="0,3,0,9" TextTrimming="CharacterEllipsis"/>
                  <Grid x:Name="MeterTrack" Height="11" ClipToBounds="True">
                    <Border Background="#223239" CornerRadius="6"/>
                    <Border x:Name="MeterFill" Width="0" HorizontalAlignment="Left" CornerRadius="6">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#39796F" Offset="0"/><GradientStop Color="#6FBB9D" Offset=".6"/><GradientStop Color="#EDC582" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Border x:Name="MeterSweep" Width="50" HorizontalAlignment="Left" Opacity="0" CornerRadius="6">
                      <Border.RenderTransform><TranslateTransform x:Name="SweepShift" X="-55"/></Border.RenderTransform>
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFE6A9" Offset="0"/><GradientStop Color="#B9FFE6A9" Offset=".55"/><GradientStop Color="#00FFE6A9" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <ProgressBar x:Name="AccessibleMeter" Minimum="0" Maximum="100" Value="0" Opacity="0" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Current download progress"/>
                  </Grid>
                  <DockPanel Margin="0,6,0,0">
                    <TextBlock x:Name="Percent" DockPanel.Dock="Right" Text="—" Style="{StaticResource Kicker}"/>
                    <TextBlock x:Name="Telemetry" Text="Waiting for cargo" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                  </DockPanel>
                </StackPanel>
              </Border>
              <DockPanel Margin="0,0,0,5">
                <TextBlock x:Name="QueueCount" DockPanel.Dock="Right" Text="0 WAITING" Style="{StaticResource Kicker}" Foreground="#89B9AC"/>
                <TextBlock Text="Haul queue" FontWeight="SemiBold"/>
              </DockPanel>
              <Grid>
                <ListBox x:Name="Jobs" AutomationProperties.Name="Haul queue" Height="145" >
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Url}"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Ink}" Margin="7,0,0,0" FontFamily="Consolas" FontSize="11"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyQueue" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock Text="◇" Foreground="#6AAB9C" FontSize="23" HorizontalAlignment="Center"/>
                  <TextBlock Text="The deck is clear." Style="{StaticResource Small}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="Cancel" Content="Stop active" IsEnabled="False" Margin="0,0,5,4"/>
                <Button x:Name="Remove" Content="Remove selected" IsEnabled="False" Margin="0,0,5,4"/>
                <Button x:Name="Retry" Content="Retry selected" IsEnabled="False" Margin="0,0,5,4"/>
                <Button x:Name="Clear" Content="Clear finished" IsEnabled="False" Margin="0,0,0,4"/>
              </WrapPanel>
              <WrapPanel Margin="0,2,0,0">
                <Button x:Name="OpenFolder" Content="Open save folder" Margin="0,0,5,4"/>
                <Button x:Name="ShowLog" Content="Ship’s log" Margin="0,0,5,4"/>
                <Button x:Name="ShowFiles" Content="Saved files (0)" Margin="0,0,0,4"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Background="#0F1B21" BorderBrush="#2B4147" BorderThickness="0,1,0,0">
      <DockPanel Margin="24,0">
        <TextBlock x:Name="ToolStatus" DockPanel.Dock="Right" Text="Checking tools…" Style="{StaticResource Kicker}" Foreground="#90C4B6"/>
        <TextBlock Text="The Background Gremlin Group  •  Developing unique tools for unique individuals" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
